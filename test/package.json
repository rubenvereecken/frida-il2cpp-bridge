{
    "name": "@frida-il2cpp/test-runner",
    "private": true,
    "version": "0.1.0",
    "license": "MIT",
    "author": "rubenvereecken",
    "contributors": [
        "vfsfitvnm"
    ],
    "main": "index.js",
    "type": "module",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "postinstall": "cd node_modules/frida && PATH=\"$(pwd)/../.bin:$PATH\" node scripts/install.js",
        "build": "pushd tests && pnpm run build && popd",
        "test": "pnpm run build && node --experimental-strip-types run.ts",
        "dev": "nodemon --watch tests --ext ts --exec \"pnpm run test\""
    },
    "dependencies": {
        "frida": "^17.2.17",
        "tap-mocha-reporter": "^5.0.4"
    },
    "devDependencies": {
        "@types/node": "^24.3.0",
        "nodemon": "^3.1.10",
        "prebuild-install": "^7.1.3"
    }
}
