{
  // Don't extend base config because it's for Node.js, not Frida
  "compilerOptions": {
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "lib": ["esnext"],
    "typeRoots": ["./node_modules/@types", "./@types", "."],
    // For tap-mocha-reporter
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts", "*.d.ts"]
}
